<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="mba_ai_assistant.AiAssistantSystray">
        <div class="o_ai_systray_item position-relative d-flex align-items-center h-100">
            <!-- Botón en la Barra Superior (Systray Icon) - Clases de texto actualizadas para usar blanco/gris claro -->
            <div t-on-click="toggleDropdown"
                 class="o_ai_systray_btn d-flex align-items-center justify-content-center px-3 h-100 cursor-pointer text-white"
                 title="Asistente de IA (Claude / Gemini / OpenAI)">
                <i class="fa fa-magic fa-lg"/>
                <span class="ms-2 d-none d-lg-inline fw-bold text-white">Asistente IA</span>
            </div>

            <!-- Desplegable del Chat -->
            <div t-if="state.isOpen and !state.minimized" class="o_ai_dropdown dropdown-menu show position-absolute end-0 p-0 shadow-lg border-0"
                 style="width: 360px; top: 100%; margin-top: 1px; z-index: 1050; border-radius: 12px; overflow: hidden;">

                <!-- Encabezado - Modificado a tema morado corporativo -->
                <div class="o_ai_header px-3 py-2 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <i class="fa fa-magic me-2 fa-lg"/>
                        <span class="fw-bold">MBA Copilot</span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <i class="fa fa-plus-circle o_ai_nueva cursor-pointer" t-on-click="nuevaConversacion" title="Nueva conversación"/>
                        <i class="fa fa-window-minimize o_ai_minimize cursor-pointer" t-on-click="minimize" title="Minimizar"/>
                        <span class="o_ai_close cursor-pointer fs-5 fw-bold" t-on-click="close">✕</span>
                    </div>
                </div>

                <!-- Historial de Conversación -->
                <div class="o_ai_chat_body p-3 overflow-auto d-flex flex-column gap-2 bg-light" style="height: 300px;">
                    <t t-foreach="state.messages" t-as="msg" t-key="msg.role + msg.content">
                        <!-- Usar color morado para los mensajes del usuario -->
                        <div t-attf-class="o_ai_msg p-2 rounded-3 max-width-80 #{msg.role === 'user' ? 'bg-primary text-white align-self-end ms-4' : 'bg-white text-dark align-self-start border me-4 shadow-sm'}">
                            <span style="white-space: pre-wrap; font-size: 13px;" t-esc="msg.content"/>
                            <div t-if="msg.role === 'assistant' and msg.logId" class="o_ai_feedback d-flex gap-2 mt-1 pt-1 border-top">
                                <i t-attf-class="fa fa-thumbs-up cursor-pointer #{msg.feedback === 'util' ? 'text-success' : 'text-muted'}"
                                   title="Esta respuesta fue útil"
                                   t-on-click="() => this.sendFeedback(msg, 'util')"/>
                                <i t-attf-class="fa fa-thumbs-down cursor-pointer #{msg.feedback === 'no_util' ? 'text-danger' : 'text-muted'}"
                                   title="Esta respuesta no fue útil"
                                   t-on-click="() => this.sendFeedback(msg, 'no_util')"/>
                                <span t-if="msg.feedback" class="text-muted" style="font-size: 11px;">¡Gracias por tu feedback!</span>
                            </div>
                        </div>
                    </t>
                    <div t-if="state.loading" class="align-self-start p-2 rounded bg-white border text-muted">
                        <i class="fa fa-circle-o-notch fa-spin me-2"/> Generando respuesta...
                    </div>
                </div>

                <!-- Entrada de Texto -->
                <div class="o_ai_footer p-2 bg-white border-top">
                    <div class="input-group input-group-sm">
                        <input type="text"
                               class="form-control border-0 bg-light py-2"
                               placeholder="Haz una pregunta o analiza el formulario..."
                               t-model="state.inputPrompt"
                               t-on-keydown="onKeyDown"
                               t-att-disabled="state.loading"/>
                        <!-- Botón de envío modificado a color morado corporativo -->
                        <button class="btn btn-primary-purple px-3 border-0"
                                type="button"
                                t-on-click="sendMessage"
                                t-att-disabled="state.loading">
                            <i class="fa fa-paper-plane"/>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Burbuja flotante cuando el chat está minimizado -->
            <div t-if="state.isOpen and state.minimized"
                 class="o_ai_bubble d-flex align-items-center justify-content-center cursor-pointer shadow-lg"
                 t-on-click="restore"
                 title="MBA Copilot (minimizado)">
                <i class="fa fa-magic fa-lg"/>
            </div>
        </div>
    </t>
</templates>
